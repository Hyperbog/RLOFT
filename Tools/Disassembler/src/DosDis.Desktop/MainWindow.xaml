<Window x:Class="DosDis.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DOSDis — Preservation Disassembler" Width="1510" Height="960"
        MinWidth="1180" MinHeight="680"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        FontFamily="Segoe UI" Closing="Window_Closing">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{StaticResource PanelBrush}" Padding="20,15">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left">
          <TextBlock Text="DOSDis" FontSize="22" FontWeight="SemiBold"/>
          <TextBlock Text="Binary preservation · Static analysis · Windows preview" FontSize="11"
                     Foreground="{StaticResource SecondaryTextBrush}"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="OpenBinaryButton" Style="{StaticResource PrimaryActionButtonStyle}" Content="Open binary" Click="OpenBinary_Click"/>
          <Button x:Name="OpenProjectButton" Content="Open project" Click="OpenProject_Click"/>
          <Button x:Name="SaveProjectButton" Content="Save project" Click="SaveProject_Click" ToolTip="LE project snapshots only. For standalone MZ, use Export for source-bound JSON or text."/>
          <Button x:Name="ExportAnalysisButton" Content="Export…" Click="ExportAnalysis_Click" ToolTip="Export source-bound LE or x86-16 MZ candidate analysis as JSON/text. Original bytes excluded by default."/>
          <Button x:Name="ExportDiagnosticButton" Content="Diagnostics…" Click="ExportDiagnostic_Click"
                  ToolTip="Export bounded session events without paths, source bytes, comments or exception messages."/>
          <Button x:Name="BackupProjectButton" Content="Backup project" Click="BackupProject_Click"
                  ToolTip="Back up your research project. If none exists, you can create one first."/>
          <Button x:Name="AnalyzeButton" Style="{StaticResource PrimaryActionButtonStyle}" Content="Analyze" Click="Analyze_Click" ToolTip="Analyze supported LE code or the validated standalone MZ entry segment as unverified candidate control flow."/>
          <Button x:Name="CancelAnalysisButton" Content="Cancel analysis" Click="CancelAnalysis_Click" IsEnabled="False"
                  ToolTip="Only enabled while analysis is running. Small originals may complete before cancellation is possible."/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Border Grid.Row="1" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="20,12">
      <DockPanel LastChildFill="True">
        <TextBlock x:Name="FileSubtitle" Text="No file loaded" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"
                   DockPanel.Dock="Left" Margin="0,0,24,0"/>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
          <TextBlock Text="Go to / find bytes" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBox x:Name="AddressBox" Width="188" FontFamily="Consolas" Text="1:0x0" Margin="0,0,8,0"
                   KeyDown="AddressBox_KeyDown"
                   ToolTip="Press Enter or Go. Address: 0000:0025, 1:0x25, file:0x225. Byte search: CD, CD 21, hex:46 04 CD 21. Repeat Enter to find next."/>
          <Button Content="Go / Find" Click="GoTo_Click" Margin="0" ToolTip="Enter searches exact original bytes or goes to a physical/object/CS:IP address; selections are shared across tabs."/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Row="2" Margin="12,12,12,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="235" MinWidth="160"/>
        <ColumnDefinition Width="5"/>
        <ColumnDefinition Width="*" MinWidth="450"/>
        <ColumnDefinition Width="5"/>
        <ColumnDefinition Width="325" MinWidth="235"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="7" Padding="12">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="EXPLORER" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"/>
            <TextBlock x:Name="BinaryName" Text="—" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="ArtifactHash" Text="SHA-256 —" Margin="0,4,0,0" FontSize="10" TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}"/>
            <TextBlock x:Name="ExplorerSectionTitle" Text="FUNCTION CANDIDATES" FontSize="11" Margin="0,24,0,0" FontWeight="SemiBold"
                       Foreground="{StaticResource SecondaryTextBrush}"/>
          </StackPanel>
          <ListBox x:Name="FunctionsList" SelectionChanged="FunctionsList_SelectionChanged"
                   DisplayMemberPath="DisplayName" VirtualizingPanel.IsVirtualizing="True"
                   VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"/>
        </DockPanel>
      </Border>
      <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>
      <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="7" Padding="10">
        <TabControl x:Name="MainTabs" Background="{StaticResource PanelBrush}" Foreground="{StaticResource PrimaryTextBrush}"
                    SelectionChanged="MainTabs_SelectionChanged">
          <TabItem Header="Disassembly">
            <DataGrid x:Name="AssemblyGrid" SelectionChanged="AssemblyGrid_SelectionChanged"
                      MouseDoubleClick="AssemblyGrid_MouseDoubleClick"
                      ToolTip="Double-click a candidate direct CALL/JMP or taken conditional branch to follow its resolved target; unresolved targets are never guessed."
                      VirtualizingPanel.VirtualizationMode="Recycling">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Location" Binding="{Binding AddressText}" Width="120"/>
                <DataGridTextColumn Header="Original bytes" Binding="{Binding Bytes}" Width="170"/>
                <DataGridTextColumn Header="Assembly" Binding="{Binding Assembly}" Width="*"/>
                <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="210"/>
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>
          <TabItem Header="Hexadecimal">
            <DockPanel>
              <TextBlock x:Name="HexLocationText" DockPanel.Dock="Top" Margin="6,4,6,8"
                         Text="No physical file position selected" TextWrapping="Wrap"
                         Foreground="{StaticResource SecondaryTextBrush}" FontFamily="Consolas" FontSize="11"/>
              <TextBox x:Name="HexView" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                       HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                       SelectionBrush="#377ED0" SelectionOpacity="0.9"
                       IsInactiveSelectionHighlightEnabled="True"
                       PreviewMouseLeftButtonDown="HexView_PreviewMouseLeftButtonDown"
                       ToolTip="Click one hex byte (two digits) to select its original-file offset. Drag to select and copy text. Go/Find highlights matched source bytes."/>
            </DockPanel>
          </TabItem>
          <TabItem Header="References">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,4,6,8">
                <CheckBox x:Name="SelectedReferencesOnlyCheckBox" Content="Selected instruction only"
                          VerticalAlignment="Center" Margin="0,0,12,0"
                          Checked="SelectedReferencesOnly_Changed"
                          Unchecked="SelectedReferencesOnly_Changed"
                          ToolTip="Unchecked: show every recorded candidate edge. Checked: show incoming and outgoing references for the selected instruction."/>
                <TextBlock x:Name="ReferencesSummary" Text="No analyzed references"
                           Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"
                           FontSize="11"/>
              </StackPanel>
              <DataGrid x:Name="ReferencesGrid" MouseDoubleClick="ReferencesGrid_MouseDoubleClick"
                        ToolTip="Double-click a resolved destination to navigate. Unresolved dynamic and far targets remain unknown.">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Source" Binding="{Binding SourceText}" Width="125"/>
                  <DataGridTextColumn Header="Direction" Binding="{Binding Direction}" Width="85"/>
                  <DataGridTextColumn Header="Destination" Binding="{Binding AddressText}" Width="125"/>
                  <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="180"/>
                  <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="*"/>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </TabItem>
        </TabControl>
      </Border>
      <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="Transparent"/>
      <Border Grid.Column="4" Background="{StaticResource PanelBrush}" CornerRadius="7" Padding="12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="130"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <DockPanel Grid.Row="0">
            <TextBlock DockPanel.Dock="Top" Text="FILE INTELLIGENCE" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,10"/>
            <TextBlock x:Name="IntelligenceEvidenceText" DockPanel.Dock="Bottom" Text="Select a field to see supporting evidence." TextWrapping="Wrap" Margin="0,8,0,0" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
            <DataGrid x:Name="IntelligenceList" SelectionChanged="IntelligenceList_SelectionChanged"
                      FontFamily="Segoe UI" FontSize="12" MinRowHeight="28"
                      ColumnHeaderHeight="33" ToolTip="Select a field to see its supporting evidence below.">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Field" Width="130" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="Value / confidence" Width="*"
                                    Binding="{Binding DisplayValue}"
                                    ElementStyle="{StaticResource IntelligenceValueTextStyle}"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
          <Border Grid.Row="1" Background="{StaticResource SubtleBorderBrush}" Height="1" Margin="0,12"/>
          <StackPanel Grid.Row="2">
            <TextBlock Text="ANALYST COMMENT" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource SecondaryTextBrush}"/>
            <TextBlock x:Name="SelectedAddressText" Text="Select an instruction" FontSize="11"
                       Foreground="{StaticResource SecondaryTextBrush}" Margin="0,8,0,6"/>
            <TextBox x:Name="NoteEditor" AcceptsReturn="True" TextWrapping="Wrap" Height="100" FontFamily="Segoe UI"
                     IsEnabled="False" ToolTip="Select an instruction to attach a comment to its exact address."
                     VerticalScrollBarVisibility="Auto"/>
            <Button x:Name="SaveNoteButton" Content="Save comment to project" Click="SaveNote_Click" Margin="0,9,0,0"
                    ToolTip="Select an instruction and save your comment. If needed, you will be asked to create a research project."/>
            <TextBlock Text="Analysis remains candidate evidence. Comments never modify original bytes."
                       TextWrapping="Wrap" FontSize="10" Margin="0,10,0,0"
                       Foreground="{StaticResource SecondaryTextBrush}"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="3" Background="{StaticResource PanelBrush}" Margin="12,8,12,12" Padding="10,8" CornerRadius="5">
      <TextBlock x:Name="StatusText" Text="Open a DOS executable to begin." FontSize="11"
                 Foreground="{StaticResource SecondaryTextBrush}"/>
    </Border>
  </Grid>
</Window>
